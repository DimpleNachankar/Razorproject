# TRUSTSHIELD Backend Configuration

# Environment
ENVIRONMENT=development

# API Settings
API_VERSION=v1
API_TITLE=TRUSTSHIELD Risk Intelligence API
API_DESCRIPTION=Merchant and Transaction Risk Assessment Platform

# CORS Settings (Frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo Mode
DEMO_MODE=true
VERBOSE_LOGGING=true

# Risk Thresholds (0-100)
AUTO_ALLOW_THRESHOLD=30
REQUIRE_REVIEW_THRESHOLD=60
AUTO_BLOCK_THRESHOLD=85

# Rate Limiting (future use)
RATE_LIMIT_PER_MINUTE=100
